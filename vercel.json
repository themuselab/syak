{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VITE_TARGET=vercel vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/:cat(nail|hair|waxing|eyelash)/:gu", "destination": "/api/seo?cat=:cat&gu=:gu" },
    { "source": "/:cat(nail|hair|waxing|eyelash)/:gu/", "destination": "/api/seo?cat=:cat&gu=:gu" },
    { "source": "/((?!assets|data|api|icon|favicon|robots|sitemap|nail|hair|waxing|eyelash|og|fallback|llms).*)", "destination": "/" }
  ]
}
